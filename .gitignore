# .gitignore for Sabha (Laravel)

# Dependencies
/node_modules
/vendor
.pnp
.pnp.*

# Testing
coverage/
/phpunit.result.cache
/.phpunit.cache
/.phpunit.result.cache

# Laravel

/public/hot
/public/storage
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/pail
.phpactor.json
Homestead.json
Homestead.yaml
/auth.json

# Production

dist/

# Misc
.DS_Store
*.pem
*.key
*.bak
*.old

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (VERY IMPORTANT - never commit these)
.env
.env.*
!.env.example

# IDEs and Editors
.idea/
.vscode/
.fleet/
.nova/
.zed/
