# Zybra API (see Zybra API Integration Doc v1). One API key, sent as a Bearer token.
# Zybra is the cash book: every rupee in/out is posted there (receipts, payments, journals).
ZYBRA_BASE_URL=https://api.zybra.in/api/v1
ZYBRA_API_KEY=
# Cash/bank account (GET /bank-accounts) and payment mode name (GET /payment-modes) for receipts
ZYBRA_DEPOSIT_ACCOUNT_ID=
ZYBRA_PAYMENT_MODE=Cash
ZYBRA_MEMBERSHIP_FEE=1000.00
# GST state code used for party addresses when a member has none (24 = Gujarat)
ZYBRA_DEFAULT_STATE_ID=24
# Income ledgers (GET /accounts, accountType income) for approved membership fees and event tickets
ZYBRA_MEMBERSHIP_INCOME_ACCOUNT_ID=
ZYBRA_EVENT_INCOME_ACCOUNT_ID=
